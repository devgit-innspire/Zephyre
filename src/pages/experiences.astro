---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Seasons from '../components/Seasons.astro';
import Lightbox from '../components/Lightbox.astro';
import { experiences, nearby } from '../data/site';

---
<Base title="Experiences" description="Our pools in the pines, wood-fired pizza, pickleball, bonfires, stargazing, open-air movies and things to do nearby at Zephyr Estate, Mussoorie." image="teepee-bonfire" overHero>
  <PageHero img="bonfire-terrace-dusk" alt="Bonfire on the stone terrace at dusk with the mountains behind" eyebrow="Experiences" title="Slow days, <em>glowing nights</em>" lede="The best things at Zephyr aren't on a schedule. Here's what a stay can hold." />

  <section class="section">
    <div class="wrap exp-list">
      {experiences.map((e, i) => (
        <article class:list={['exp-row reveal', i % 2 && 'alt']}>
          <div class="frame zoom" style={e.focus && `--focus: ${e.focus}`}><Img src={e.img} alt={e.title} sizes="(min-width: 900px) 50vw, 100vw" /></div>
          <div class="exp-copy">
            <span class="tag">{e.tag}</span>
            <h2>{e.title}</h2>
            <p class="lede">{e.text}</p>
            {e.gallery && (
              <div class="exp-thumbs">
                {e.gallery.map((g) => (
                  <a href={`/images/${g}-2000.webp`} class="frame zoom" data-lb data-alt={e.title}><Img src={g} alt={e.title} sizes="160px" /></a>
                ))}
              </div>
            )}
            <button class="link-arrow as-btn" data-enquire>Add to my stay <Icon name="arrow" /></button>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Around Zephyr</p>
        <h2>Worth the short drive</h2>
      </div>
      <ol class="nearby">
        {nearby.map((t, i) => (
          <li class="reveal" data-delay={String(i % 3)}>
            <p class="km">{t.time}</p>
            <h3>{t.label}</h3>
            <p>{t.places.map((p) => p.name).join(' · ')}</p>
          </li>
        ))}
      </ol>
      <a class="btn forest" href="/explore">Explore everything nearby <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <Seasons />
  <Lightbox />
</Base>

<style>
  .exp-list { display: grid; gap: clamp(64px, 9vw, 120px); }
  .exp-row { display: grid; gap: 28px; align-items: center; }
  @media (min-width: 900px) {
    .exp-row { grid-template-columns: 1.1fr 1fr; gap: 80px; }
    .exp-row.alt .frame { order: 2; }
  }
  .exp-row .frame { aspect-ratio: 4 / 3; border-radius: var(--radius-l); box-shadow: var(--shadow-soft); }
  .exp-row .frame :global(img) { object-position: var(--focus, 50% 50%); }
  .exp-copy h2 { font-size: clamp(2.2rem, 4vw, 3.4rem); margin: 16px 0 14px; }
  .exp-copy .lede { margin-bottom: 22px; }
  .exp-thumbs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 0 0 22px; max-width: 420px; }
  .exp-thumbs .frame { display: block; aspect-ratio: 3 / 4; border-radius: var(--radius-s); }
  .as-btn { background: none; border: 0; border-bottom: 1px solid currentColor; padding: 0 0 2px; min-height: 44px; }
  .nearby { list-style: none; margin: 0 0 36px; padding: 0; display: grid; gap: 14px; }
  @media (min-width: 640px) { .nearby { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .nearby { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .nearby li { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
  .km { font-weight: 700; font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--brass); margin-bottom: 6px; }
  .nearby h3 { margin-bottom: 8px; }
  .nearby p:last-child { color: var(--ink-soft); }
</style>
