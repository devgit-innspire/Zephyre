---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import Reels from '../components/Reels.astro';
import Lightbox from '../components/Lightbox.astro';
import dims from '../data/images.json';
import { seo } from '../data/site';

const groups = [
  { key: 'pools', label: 'Pool & pickleball', imgs: ['pool-pines', 'pools-above', 'pickleball-court', 'catalogue-pool', 'pool-night-drinks', 'pool-loungers', 'pool-winter', 'aerial-pools-close', 'pool-night-pizza'] },
  { key: 'estate', label: 'Estate & views', imgs: ['bonfire-pine-dusk', 'aerial-tents', 'valley-clouds', 'stone-stairs', 'terrace-sculpture', 'buddha-garden', 'vine-tunnel', 'valley-wide', 'vine-path', 'teepee-garden', 'canna-valley', 'stone-patio', 'cafe-yellow', 'cat-kumaon-exterior', 'monsoon-mist'] },
  { key: 'rooms', label: 'Rooms', imgs: ['cat-sierra-living', 'cat-heaven-bedroom', 'cat-stoneva-baywindow', 'cat-imperial-bedroom-1', 'cat-kumaon-bedroom-1', 'cat-timberhill-balcony', 'cat-tent-bedroom-1', 'cat-hut-bedroom-1', 'cat-sierra-dining', 'cat-bliss-bedroom-2', 'cat-stoneva-bedroom-1', 'cat-imperial-deck', 'cat-heaven-balcony', 'cat-kumaon-bedroom-2', 'cat-timberhill-baywindow', 'cat-tent-bedroom-3', 'cat-hut-seating', 'cat-bliss-passage'] },
  { key: 'pizza', label: 'Wood-fired pizza', imgs: ['pizza-oven-night', 'pizza-oven-fire', 'pizza-fresh-board', 'pizza-oven-dome', 'pizza-topping', 'pool-night-pizza'] },
  { key: 'food', label: 'Lavish food', imgs: ['food-thali-tray', 'food-poolside-breakfast', 'food-dinner-spread', 'food-dessert', 'food-breakfast-garden', 'food-poolside-snacks', 'food-breakfast-table', 'pool-dinner', 'breakfast-mountains', 'high-tea-sunrays', 'candlelight-dinner', 'golden-hour-tea', 'tea-pour', 'bday-canopy-dinner'] },
  { key: 'nights', label: 'Nights', imgs: ['aerial-night-glow', 'bonfire-overhead', 'courtyard-fairy', 'stars-valley', 'stars-valley-2', 'evening-fire-courtyard', 'teepee-bonfire', 'movie-night', 'cafe-yellow-dusk', 'cottage-night'] },
];
const alts: Record<string, string> = { 'pool-pines': 'Swimming pool among the pines at Zephyr Estate, Mussoorie', 'pools-above': 'The main pool and kids’ pool seen from above, ringed by trees', 'catalogue-pool': 'Blue-mosaic main pool and kids’ pool with stone paving', 'pool-night-drinks': 'The pool lit up at night with drinks on a poolside table', 'pool-loungers': 'Loungers beside the main pool and kids’ pool', 'pool-winter': 'The swimming pool on a bright winter day in the Mussoorie hills', 'aerial-pools-close': 'Aerial view of the pool among the cottages and trees', 'bonfire-pine-dusk': 'Bonfire at dusk under tall pines', 'aerial-tents': 'Aerial view of the luxury tents in the forest', 'valley-clouds': 'Clouds rolling through the valley below the estate', 'stone-stairs': 'Stone stairway through the gardens', 'terrace-sculpture': 'Stone terrace with a sculpture and valley views', 'buddha-garden': 'Buddha statue in the garden', 'vine-tunnel': 'Vine-covered tunnel walkway', 'valley-wide': 'Wide view of the green Garhwal valley near Kempty Falls', 'vine-path': 'Garden path under vines', 'teepee-garden': 'Teepee in the garden', 'canna-valley': 'Canna lilies in bloom with the valley behind', 'stone-patio': 'Stone patio with seating', 'cafe-yellow': 'Yellow café corner with garden seating', 'cat-kumaon-exterior': 'The Kumaon Cottage from outside', 'monsoon-mist': 'Monsoon mist over the hills', 'cat-sierra-living': 'Living room of The Sierra family villa', 'cat-heaven-bedroom': 'Four-poster bed in The Heaven luxury room', 'cat-stoneva-baywindow': 'French bay window seat in The French Stoneva', 'cat-imperial-bedroom-1': 'Four-poster bed in the Grand Imperial luxury tent', 'cat-kumaon-bedroom-1': 'Bedroom with a wooden ceiling in the Kumaon Cottage', 'cat-timberhill-balcony': 'Balcony with armchairs at The French Timber Hill', 'cat-tent-bedroom-1': 'Carved wooden bed in a Classic luxury tent', 'cat-hut-bedroom-1': 'Bedroom in a Classic stone hut', 'cat-sierra-dining': 'Private dining area in The Sierra villa', 'cat-bliss-bedroom-2': 'The Bliss luxury room with a timber ceiling', 'cat-stoneva-bedroom-1': 'Bedroom in The French Stoneva', 'cat-imperial-deck': 'Covered deck of the Grand Imperial luxury tent', 'cat-heaven-balcony': 'Balcony passage with valley views outside the luxury rooms', 'cat-kumaon-bedroom-2': 'Second view of the Kumaon Cottage bedroom', 'cat-timberhill-baywindow': 'French bay window looking at the hills in The French Timber Hill', 'cat-tent-bedroom-3': 'Inside a Classic luxury tent', 'cat-hut-seating': 'Window seating corner in a Classic stone hut', 'cat-bliss-passage': 'Shared balcony passage of the luxury rooms', 'breakfast-mountains': 'Breakfast with a view of the mountains', 'high-tea-sunrays': 'High tea on the stone terrace in afternoon sun', 'candlelight-dinner': 'Candlelit dinner set-up', 'golden-hour-tea': 'Tea and bakes at golden hour', 'tea-pour': 'Pouring chai on the terrace', 'bday-canopy-dinner': 'Birthday dinner under a fairy-lit canopy', 'aerial-night-glow': 'The estate glowing at night from above', 'bonfire-overhead': 'Bonfire circle seen from above', 'courtyard-fairy': 'Courtyard strung with fairy lights at night', 'stars-valley': 'Stars over the Garhwal hills from the ridge', 'stars-valley-2': 'Night sky full of stars above the valley', 'evening-fire-courtyard': 'Evening fire in the courtyard', 'teepee-bonfire': 'Teepee lit up beside a bonfire', 'movie-night': 'Open-air movie night by the fire pit', 'cafe-yellow-dusk': 'Yellow café corner lit up at dusk', 'cottage-night': 'Cottage lit up at night', 'pool-night-pizza': 'wood-fired pizza by the pool at night', 'pool-dinner': 'dinner spread by the pool', 'pickleball-court': 'Pickleball court at Zephyr Estate, against a stone wall in the forest', 'pizza-oven-fire': 'pizza baking in the wood-fired oven', 'pizza-fresh-board': 'fresh wood-fired pizza on a wooden board', 'pizza-oven-dome': 'the mosaic-tiled wood-fired pizza oven', 'pizza-topping': 'topping a pizza at the pizza workshop', 'pizza-oven-night': 'the blue-mosaic wood-fired oven in the garden at night', 'food-poolside-breakfast': 'breakfast by the pool', 'food-poolside-snacks': 'snacks by the pool', 'food-dessert': 'dessert plate by the window', 'food-breakfast-garden': 'breakfast table with a garden view', 'food-thali-tray': 'a tray of dal, curries, rice, kadhi and fresh salad', 'food-dinner-spread': 'dinner spread of curries, rice, raita, rotis and dessert', 'food-breakfast-table': 'breakfast table with fresh juices, a fruit basket and toast' };
const alt = (s: string) => alts[s] ?? s.replace(/-\d$/, '').replace(/-/g, ' ');
const tall = (s: string) => { const [w, h] = (dims as Record<string, number[]>)[s]; return h > w; };
---
<Base title="Gallery & reels" seoTitle={seo.pages.gallery.title} description={seo.pages.gallery.description} image="pools-above" imageAlt="The main pool and kids’ pool among the pines at Zephyr Estate, Mussoorie" crumbs={[{ name: 'Gallery', path: '/gallery' }]} overHero>
  <PageHero img="aerial-forest" alt="Zephyr Estate seen from a drone above the forest" eyebrow="Gallery" title="See it before <em>you feel it</em>" />

  <nav class="wrap tabs" aria-label="Gallery sections">
    {groups.map((g) => <a href={`#${g.key}`}>{g.label}</a>)}
    <a href="#reels-h">Reels</a>
  </nav>

  {groups.map((g) => (
    <section class="section gsec" id={g.key} aria-labelledby={`${g.key}-h`}>
      <div class="wrap">
        <h2 id={`${g.key}-h`}>{g.label}</h2>
        <div class="masonry">
          {g.imgs.map((s) => (
            <a href={`/images/${s}-2000.webp`} class:list={['frame zoom reveal', tall(s) && 'tall']} data-lb data-alt={alt(s)}>
              <Img src={s} alt={alt(s)} sizes="(min-width: 1100px) 33vw, (min-width: 600px) 50vw, 100vw" />
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <Reels heading="Watch the estate come alive" />
  <Lightbox />
</Base>

<style>
  .tabs { display: flex; gap: 10px; overflow-x: auto; padding-top: 32px; padding-bottom: 4px; scrollbar-width: none; }
  .tabs a { flex: none; padding: 12px 20px; border-radius: 999px; border: 1px solid var(--line); text-decoration: none; font-weight: 600; font-size: 0.9rem; background: var(--paper); transition: background-color 200ms, color 200ms; }
  .tabs a:hover { background: var(--deodar); color: #fff; border-color: var(--deodar); }
  .gsec { padding-block: 56px; }
  .gsec h2 { margin-bottom: 28px; }
  .masonry { columns: 1; column-gap: 14px; }
  @media (min-width: 600px) { .masonry { columns: 2; } }
  @media (min-width: 1100px) { .masonry { columns: 3; } }
  .masonry .frame { display: block; margin-bottom: 14px; break-inside: avoid; aspect-ratio: 4 / 3; }
  .masonry .frame.tall { aspect-ratio: 3 / 4; }
</style>
