---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Ridge from '../components/Ridge.astro';
import WindLine from '../components/WindLine.astro';
import BookingBar from '../components/BookingBar.astro';
import StayCard from '../components/StayCard.astro';
import Seasons from '../components/Seasons.astro';
import Reels from '../components/Reels.astro';
import { site, seo, stays, experiences, dayTimeline, driveRoute, feast, faqs, gallery, categories, catalogueUrl, enquiry, pages, t, rich } from '../data/site';
const c = pages.home;
const featured = stays.filter((s) => s.featured);
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const homeExperiences = experiences.filter((e) => !e.signature).slice(0, 6);
// Layout of the three pool photos (by position) and the icons for the pizza points
const poolTiles = [
  { cls: 'p-main', delay: undefined, sizes: '(min-width: 900px) 46vw, 100vw' },
  { cls: 'p-night', delay: '1', sizes: '(min-width: 900px) 18vw, 45vw' },
  { cls: 'p-court', delay: '2', sizes: '(min-width: 900px) 18vw, 45vw' },
];
const pizzaIcons = ['flame', 'sparkles', 'check'] as const;
---
<Base
  title={site.name}
  seoTitle={seo.pages.home.title}
  description={seo.pages.home.description}
  imageAlt={c.shareImageAlt}
  schema={[faqSchema]}
  overHero
>
  <!-- ───────── HERO ───────── -->
  <section class="hero" aria-label={c.hero.label}>
    <video class="hero-video" data-autoplay autoplay muted loop playsinline preload="auto" poster="/video/hero.webp" aria-hidden="true">
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade"></div>
    <div class="mist mist-1" aria-hidden="true"></div>
    <div class="mist mist-2" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <p class="hero-eyebrow">
        <span class="chip"><Icon name="pin" size={15} /> {c.hero.locationChip}</span>
        <span class="chip" hidden><Icon name="thermo" size={15} /><span data-temp></span></span>
      </p>
      <h1><span class="h1-kicker">{c.hero.kicker}</span>{rich(c.hero.heading).map((p) => p.br ? <br /> : p.em ? <em>{p.text}</em> : p.text)}</h1>
      <p class="hero-lede">{t(c.hero.intro)}</p>
      <div class="hero-bar"><BookingBar /></div>
    </div>
    <a href="#story" class="scroll-cue" aria-label={c.hero.scrollLabel}><span></span></a>
  </section>

  <!-- ───────── STORY ───────── -->
  <section class="section story" id="story">
    <div class="wrap story-grid">
      <div class="story-copy">
        <p class="eyebrow reveal">{c.story.eyebrow}</p>
        <h2 class="reveal">{rich(c.story.heading).map((p) => p.br ? <br /> : p.em ? <em class="wind">{p.text}</em> : p.text)}</h2>
        <WindLine />
        <p class="lede reveal" data-delay="1">
          {c.story.lede}
        </p>
        <p class="reveal" data-delay="1" style="color: var(--ink-soft); font-size: 1.05rem; line-height: 1.7; margin-top: -0.2em;">
          {c.story.text}
        </p>
        <dl class="facts reveal" data-delay="2">
          {c.story.facts.map((f) => (
            <div><dt>{t(f.value)}{f.unit && <small>{f.unit}</small>}</dt><dd>{rich(f.label).map((p) => p.br ? <br /> : p.em ? <em>{p.text}</em> : p.text)}</dd></div>
          ))}
        </dl>
      </div>
      <div class="story-media">
        <div class="frame arch story-main reveal"><Img src={c.story.mainPhoto.image} alt={c.story.mainPhoto.alt} sizes="(min-width: 900px) 440px, 80vw" /></div>
        <div class="frame story-float reveal" data-delay="2"><Img src={c.story.smallPhoto.image} alt={c.story.smallPhoto.alt} sizes="(min-width: 900px) 240px, 40vw" /></div>
        <p class="story-note reveal" data-delay="3"><Icon name="sparkles" size={16} /> {c.story.note}</p>
      </div>
    </div>
  </section>

  <!-- ───────── POOLS (our USP) ───────── -->
  <section class="section pools" id="pools" aria-labelledby="pools-h">
    <div class="wrap pools-grid">
      <div class="pools-media">
        {c.pools.photos.map((ph, i) => {
          const tile = poolTiles[i] ?? poolTiles[poolTiles.length - 1];
          return <a href="/gallery#pools" class:list={['frame zoom', tile.cls, 'reveal']} data-delay={tile.delay} aria-label={c.pools.photoLinkLabel}><Img src={ph.image} alt={ph.alt} sizes={tile.sizes} /><span class="p-chip">{ph.label}</span></a>;
        })}
      </div>
      <div class="pools-copy">
        <p class="pools-badge reveal"><Icon name="waves" size={16} /> {c.pools.badge}</p>
        <h2 id="pools-h" class="reveal">{rich(c.pools.heading).map((p) => p.br ? <br /> : p.em ? <em class="wind">{p.text}</em> : p.text)}</h2>
        <WindLine />
        <p class="lede reveal" data-delay="1">{c.pools.lede}</p>
        <ul class="ticks reveal" data-delay="1">
          {c.pools.points.map((pt) => <li><Icon name="check" size={18} /> {pt}</li>)}
        </ul>
        <div class="pools-actions reveal" data-delay="2">
          <button class="btn" data-enquire>{c.pools.bookButton} <Icon name="arrow" /></button>
          <a class="link-arrow" href="/gallery#pools">{c.pools.galleryLink} <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── STAYS ───────── -->
  <section class="section stays-sec" aria-labelledby="stays-h">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eyebrow">{c.stays.eyebrow}</p>
          <h2 id="stays-h">{rich(c.stays.heading).map((p) => p.br ? <br /> : p.em ? <em class="wind">{p.text}</em> : p.text)}</h2>
        </div>
        <p class="lede">{c.stays.lede}</p>
      </div>
      <ul class="cat-chips" aria-label={c.stays.categoriesLabel}>
        {categories.map((c) => {
          const n = stays.filter((s) => s.category === c.key).reduce((a, s) => a + s.units, 0);
          return <li><a href={`/stays#${c.key}`}>{c.label} <span>{n}</span></a></li>;
        })}
      </ul>
      <div class="stays-grid">
        {featured.map((s, i) => <StayCard stay={s} index={i} />)}
      </div>
      <div class="stays-more">
        <a class="btn forest" href="/stays">{t(c.stays.allRoomsButton)}</a>
        <a class="link-arrow" href={catalogueUrl} target="_blank" rel="noopener"><Icon name="whatsapp" /> {c.stays.catalogueLink}</a>
      </div>
    </div>
  </section>

  <!-- ───────── WHOLE ESTATE ───────── -->
  <section class="estate" id="estate" aria-labelledby="estate-h">
    <div class="estate-bg"><Img src={c.estate.image} alt={c.estate.imageAlt} sizes="100vw" /></div>
    <div class="wrap estate-inner">
      <div class="estate-card reveal">
        <p class="eyebrow">{c.estate.eyebrow}</p>
        <h2 id="estate-h">{rich(c.estate.heading).map((p) => p.br ? <br /> : p.em ? <em class="wind">{p.text}</em> : p.text)}</h2>
        <p>{c.estate.text}</p>
        <ul class="ticks">
          {c.estate.points.map((pt) => <li><Icon name="check" size={18} /> {pt}</li>)}
        </ul>
        <button class="btn" data-enquire data-stay={t(enquiry.wholeEstateValue)}>{c.estate.button}</button>
      </div>
    </div>
  </section>

  <!-- ───────── WOOD-FIRED PIZZA ───────── -->
  <section class="section pizza on-dark grain" id="pizza" aria-labelledby="pizza-h">
    <div class="wrap pizza-grid">
      <div class="pizza-reel frame reveal">
        <video data-autoplay muted loop playsinline preload="none" poster="/reels/reel-pizza-workshop.webp" aria-label={c.pizza.videoLabel}>
          <source src="/reels/reel-pizza-workshop.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="pizza-copy">
        <p class="eyebrow reveal">{c.pizza.eyebrow}</p>
        <h2 id="pizza-h" class="reveal">{rich(c.pizza.heading).map((p) => p.br ? <br /> : p.em ? <em class="wind">{p.text}</em> : p.text)}</h2>
        <p class="lede reveal" data-delay="1">{c.pizza.lede}</p>
        <ul class="ticks reveal" data-delay="1">
          {c.pizza.points.map((pt, i) => <li><Icon name={pizzaIcons[i] ?? 'check'} size={18} /> {pt}</li>)}
        </ul>
        <div class="pizza-stills reveal" data-delay="2">
          {c.pizza.photos.map((p) => (
            <a href="/gallery#pizza" class="frame zoom" aria-label={c.pizza.photoLinkLabel}><Img src={p} alt="" sizes="(min-width: 900px) 180px, 30vw" /></a>
          ))}
        </div>
        <div class="pizza-actions reveal" data-delay="2">
          <button class="btn" data-enquire>{c.pizza.button} <Icon name="arrow" /></button>
          <a class="link-arrow" href="/gallery#pizza">{c.pizza.galleryLink} <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── LAVISH FOOD ───────── -->
  <section class="section feast" id="food" aria-labelledby="feast-h">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eyebrow">{c.food.eyebrow}</p>
          <h2 id="feast-h">{rich(c.food.heading).map((p) => p.br ? <br /> : p.em ? <em class="wind">{p.text}</em> : p.text)}</h2>
        </div>
        <p class="lede">{c.food.lede}</p>
      </div>
      <div class="feast-grid">
        {feast.map((f, i) => (
          <a href="/gallery#food" class:list={['frame zoom reveal', `f-${i}`]} data-delay={String(i % 3)}>
            <Img src={f.img} alt={f.label} sizes={i === 0 || i === 4 ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'} />
            <span class="feast-label">{f.label}</span>
          </a>
        ))}
      </div>
      <div class="feast-actions">
        <button class="btn forest" data-enquire>{c.food.button}</button>
        <a class="link-arrow" href="/gallery#food">{c.food.galleryLink} <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ───────── A DAY AT ZEPHYR ───────── -->
  <section class="section day" aria-labelledby="day-h">
    <div class="wrap">
      <div class="section-head day-head">
        <p class="eyebrow">{c.day.eyebrow}</p>
        <h2 id="day-h">{rich(c.day.heading).map((p) => p.br ? <br /> : p.em ? <em class="wind">{p.text}</em> : p.text)}</h2>
      </div>
      <ol class="timeline">
        {dayTimeline.map((d, i) => (
          <li class:list={['tl-item reveal', i % 2 && 'alt']}>
            <div class="tl-media frame"><Img src={d.img} alt={d.title} sizes="(min-width: 900px) 520px, 90vw" /></div>
            <div class="tl-copy">
              <span class="tl-time">{d.time}</span>
              <h3>{d.title}</h3>
              <p>{d.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ───────── MIST BAND ───────── -->
  <section class="band" aria-label={c.interlude.label}>
    <video data-autoplay autoplay muted loop playsinline preload="none" poster="/video/mist.webp" aria-hidden="true">
      <source src="/video/mist.mp4" type="video/mp4" />
    </video>
    <div class="band-copy wrap">
      <p class="display reveal">{rich(c.interlude.quote).map((p) => p.br ? <br /> : p.em ? <em>{p.text}</em> : p.text)}</p>
    </div>
  </section>

  <!-- ───────── EXPERIENCES ───────── -->
  <section class="section exp" aria-labelledby="exp-h">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eyebrow">{c.experiences.eyebrow}</p>
          <h2 id="exp-h">{rich(c.experiences.heading).map((p) => p.br ? <br /> : p.em ? <em class="wind">{p.text}</em> : p.text)}</h2>
        </div>
        <p class="lede">{c.experiences.lede}</p>
      </div>
      <div class="exp-grid">
        {homeExperiences.map((e, i) => (
          <article class:list={['exp-card reveal', `exp-${i}`]} data-delay={String(i % 3)}>
            <div class="frame zoom" style={e.focus && `--focus: ${e.focus}`}><Img src={e.img} alt={e.title} sizes="(min-width: 1100px) 400px, (min-width: 700px) 50vw, 100vw" /></div>
            <div class="exp-copy">
              <span class="tag">{e.tag}</span>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="exp-more"><a class="link-arrow" href="/experiences">{c.experiences.moreLink} <Icon name="arrow" /></a></p>
    </div>
  </section>

  <Seasons />

  <Reels />

  <!-- ───────── GALLERY TEASER ───────── -->
  <section class="section moments" aria-labelledby="mom-h">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eyebrow">{c.moments.eyebrow}</p>
          <h2 id="mom-h">{rich(c.moments.heading).map((p) => p.br ? <br /> : p.em ? <em class="wind">{p.text}</em> : p.text)}</h2>
        </div>
        <p class="lede">{c.moments.lede}</p>
      </div>
      <div class="mosaic">
        {gallery.slice(0, 7).map((g, i) => (
          <a href="/gallery" class:list={['frame zoom reveal', `m-${i}`]} data-delay={String(i % 3)} aria-label={c.moments.photoLinkLabel}>
            <Img src={g} alt="" sizes="(min-width: 900px) 33vw, 50vw" />
          </a>
        ))}
      </div>
      <p class="center"><a class="btn forest" href="/gallery">{c.moments.button}</a></p>
    </div>
  </section>

  <!-- ───────── GETTING HERE ───────── -->
  <section class="section route on-dark grain" id="route" aria-labelledby="route-h">
    <Ridge variant="light" flip />
    <div class="wrap route-grid">
      <div>
        <p class="eyebrow">{c.route.eyebrow}</p>
        <h2 id="route-h">{rich(c.route.heading).map((p) => p.br ? <br /> : p.em ? <em class="wind">{p.text}</em> : p.text)}</h2>
        <p class="lede">{t(c.route.lede, { hours: driveRoute.hours })}</p>
        <ol class="route-line" aria-label={c.route.routeLabel}>
          {driveRoute.stops.map((d, i) => (
            <li class:list={[i === driveRoute.stops.length - 1 && 'rl-here']}><span class="rl-dot"></span><span class="rl-place">{d.place}</span><span class="rl-km">{d.note}</span></li>
          ))}
        </ol>
        <div class="route-actions">
          <a class="btn light" href={site.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" /> {c.route.directionsButton}</a>
          <a class="link-arrow" href="/getting-here">{c.route.travelTipsLink} <Icon name="arrow" /></a>
          <a class="link-arrow" href="/explore">{c.route.nearbyLink} <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="route-map frame">
        <iframe title={c.route.mapTitle} src={site.mapEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <!-- ───────── FAQ ───────── -->
  <section class="section faq" aria-labelledby="faq-h">
    <div class="wrap faq-grid">
      <div>
        <p class="eyebrow">{c.faq.eyebrow}</p>
        <h2 id="faq-h">{rich(c.faq.heading).map((p) => p.br ? <br /> : p.em ? <em class="wind">{p.text}</em> : p.text)}</h2>
        <p class="lede">{c.faq.lede}</p>
        <a class="btn forest" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener"><Icon name="whatsapp" /> {c.faq.whatsappButton}</a>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}<Icon name="chevron" size={20} /></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────── CLOSING CTA ───────── -->
  <section class="closing" aria-labelledby="close-h">
    <video data-autoplay autoplay muted loop playsinline preload="none" poster="/video/bonfire.webp" aria-hidden="true">
      <source src="/video/bonfire.mp4" type="video/mp4" />
    </video>
    <div class="closing-shade"></div>
    <div class="wrap closing-inner">
      <p class="eyebrow">{c.closing.eyebrow}</p>
      <h2 id="close-h">{rich(c.closing.heading).map((p) => p.br ? <br /> : p.em ? <em>{p.text}</em> : p.text)}</h2>
      <p class="lede">{c.closing.lede}</p>
      <div class="closing-actions">
        <button class="btn" data-enquire>{c.closing.button} <Icon name="arrow" /></button>
        <a class="btn ghost" href={`tel:${site.phone}`}><Icon name="phone" /> {site.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; color: #fff; overflow: hidden; background: var(--pine-night); }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: hero-zoom 30s var(--ease) both; }
  @keyframes hero-zoom { from { transform: scale(1.12); } to { transform: scale(1); } }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10, 16, 12, 0.35) 0%, rgba(10, 16, 12, 0.1) 35%, rgba(10, 16, 12, 0.72) 100%); }
  .mist { position: absolute; left: -20%; right: -20%; height: 40%; pointer-events: none; opacity: 0.5; filter: blur(30px);
    background: radial-gradient(ellipse at 30% 50%, rgba(255, 255, 255, 0.45), transparent 60%), radial-gradient(ellipse at 75% 60%, rgba(255, 255, 255, 0.3), transparent 55%); }
  .mist-1 { bottom: 18%; animation: drift 38s linear infinite alternate; }
  .mist-2 { bottom: 4%; opacity: 0.35; animation: drift 52s linear infinite alternate-reverse; }
  @keyframes drift { from { transform: translateX(-8%); } to { transform: translateX(8%); } }
  .hero-inner { position: relative; z-index: 1; padding-top: calc(var(--nav-h) + 40px); padding-bottom: clamp(40px, 7vh, 72px); }
  .hero-eyebrow { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; animation: rise 1s var(--ease) 0.2s both; }
  .hero h1 { text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25); animation: rise 1.1s var(--ease) 0.35s both; }
  .hero h1 em { font-style: italic; color: #f4d9b4; }
  .h1-kicker { display: block; margin-bottom: 14px; font: 600 clamp(0.72rem, 1.1vw, 0.85rem)/1.4 var(--font-body); letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); }
  .hero-lede { max-width: 52ch; font-size: clamp(1.05rem, 1.5vw, 1.2rem); color: rgba(255, 255, 255, 0.9); margin: 22px 0 36px; animation: rise 1.1s var(--ease) 0.5s both; }
  .hero-bar { max-width: 1040px; animation: rise 1.1s var(--ease) 0.65s both; }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }
  .scroll-cue { position: absolute; z-index: 1; right: var(--gutter); bottom: 40px; width: 28px; height: 46px; border: 1.5px solid rgba(255, 255, 255, 0.7); border-radius: 20px; display: none; }
  .scroll-cue span { position: absolute; left: 50%; top: 9px; width: 3px; height: 8px; margin-left: -1.5px; border-radius: 2px; background: #fff; animation: cue 1.8s var(--ease) infinite; }
  @keyframes cue { 0% { opacity: 0; transform: translateY(0); } 40% { opacity: 1; } 100% { opacity: 0; transform: translateY(14px); } }
  @media (min-width: 1200px) { .scroll-cue { display: block; } }

  /* STORY */
  .story-grid { display: grid; gap: 64px; align-items: center; }
  @media (min-width: 900px) { .story-grid { grid-template-columns: 1.05fr 1fr; gap: 80px; } }
  .story-copy h2 { margin-bottom: 14px; }
  .story-copy .lede { margin-top: 22px; }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 40px 0 0; padding-top: 28px; border-top: 1px solid var(--line); }
  .facts dt { font: 400 clamp(2.6rem, 5vw, 3.6rem)/1 var(--font-display); color: var(--deodar); }
  .facts dt small { font-size: 0.4em; margin-left: 4px; font-family: var(--font-body); font-weight: 600; }
  .facts dd { margin: 8px 0 0; font-size: 0.86rem; color: var(--ink-soft); line-height: 1.4; }
  .story-media { position: relative; padding: 0 8% 60px 0; }
  .story-main { aspect-ratio: 4 / 5.2; max-height: calc(100vh - var(--nav-h, 72px) - 64px); width: 100%; box-shadow: var(--shadow-lift); }
  .story-float { position: absolute; right: 0; bottom: 0; width: 46%; aspect-ratio: 4 / 3; border: 8px solid var(--mist); border-radius: var(--radius-l); box-shadow: var(--shadow-soft); }
  .story-note { position: absolute; left: -10px; bottom: 14px; display: inline-flex; gap: 8px; align-items: center; margin: 0; padding: 12px 18px; border-radius: 999px; background: var(--paper); box-shadow: var(--shadow-soft); font-size: 0.86rem; font-weight: 600; max-width: 60%; }
  .story-main :global(img) { object-position: 50% 50%; }
  .story-note :global(svg) { color: var(--brass); flex: none; }

  /* POOLS */
  .pools { background: linear-gradient(180deg, var(--mist) 0%, #e4eef0 100%); }
  .pools-grid { display: grid; gap: 56px; align-items: center; }
  @media (min-width: 900px) { .pools-grid { grid-template-columns: 1.15fr 1fr; gap: 80px; } }
  .pools-media { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 899px) { .pools-media { order: 2; } }
  .pools-media .frame { display: block; border-radius: var(--radius-l); box-shadow: var(--shadow-soft); }
  .p-main { grid-column: span 2; aspect-ratio: 4 / 3; }
  .p-night, .p-court { aspect-ratio: 1; }
  .pools-media .frame { position: relative; }
  .p-court :global(img) { object-position: 50% 62%; }
