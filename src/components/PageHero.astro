---
import Img from './Img.astro';
interface Props { img: string; alt: string; eyebrow: string; title: string; lede?: string }
const { img, alt, eyebrow, title, lede } = Astro.props;
---
<section class="phero">
  <div class="phero-bg"><Img src={img} alt={alt} sizes="100vw" eager /></div>
  <div class="wrap phero-inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1 set:html={title} />
    {lede && <p class="phero-lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .phero { position: relative; min-height: min(78vh, 720px); display: flex; align-items: flex-end; color: #fff; overflow: hidden; background: var(--pine-night); }
  .phero-bg { position: absolute; inset: 0; animation: ph-zoom 14s var(--ease) both; }
  .phero-bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @keyframes ph-zoom { from { transform: scale(1.08); } }
  .phero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10, 16, 12, 0.5), rgba(10, 16, 12, 0.1) 40%, rgba(10, 16, 12, 0.78)); }
  .phero-inner { position: relative; z-index: 1; padding-block: calc(var(--nav-h) + 60px) clamp(48px, 7vw, 80px); }
  .phero .eyebrow { color: #f4d9b4; }
  .phero h1 { font-size: clamp(2.8rem, 7vw, 5.8rem); max-width: 14ch; }
  .phero h1 :global(em) { color: #f4d9b4; }
  .phero-lede { max-width: 54ch; margin: 20px 0 0; font-size: 1.15rem; color: rgba(255, 255, 255, 0.88); }
</style>
