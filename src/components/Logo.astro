---
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<span class:list={['logo', cls]}>
  <svg class="logo-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <path d="M4 32 L14 17 L20 25 L27 13 L36 32 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
    <path d="M6 10 C 12 6, 18 6, 22 9 S 31 12, 35 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    <path d="M10 14 C 14 12, 17 12, 20 13.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.7" />
  </svg>
  <span class="logo-text">
    <span class="logo-name">Zephyr</span>
    <span class="logo-sub">Estate · @ Dimta Stay</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo-mark { width: 34px; height: 34px; flex: none; }
  .logo-text { display: grid; line-height: 1; }
  .logo-name { font: 500 1.7rem/0.9 var(--font-display); letter-spacing: 0.01em; }
  .logo-sub { font: 600 0.58rem/1 var(--font-body); letter-spacing: 0.24em; text-transform: uppercase; opacity: 0.8; margin-top: 4px; }
</style>
