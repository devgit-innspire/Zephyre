---
import Icon from './Icon.astro';
---
<dialog class="lightbox" data-lightbox aria-label="Photo viewer">
    <figure><img alt="" /><figcaption></figcaption></figure>
    <button class="lb-btn lb-close" data-lb-close aria-label="Close"><Icon name="x" /></button>
    <button class="lb-btn lb-prev" data-lb-prev aria-label="Previous photo"><Icon name="arrow" class="flip-x" /></button>
    <button class="lb-btn lb-next" data-lb-next aria-label="Next photo"><Icon name="arrow" /></button>
  </dialog>

<style>
  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(10, 14, 12, 0.96); color: #fff; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox figure { margin: 0; display: grid; gap: 12px; justify-items: center; padding: 60px 16px; }
  .lightbox img { max-width: min(1400px, 92vw); max-height: 80dvh; object-fit: contain; border-radius: 8px; }
  .lightbox figcaption { color: var(--on-dark-soft); font-size: 0.9rem; }
  .lb-btn { position: fixed; width: 52px; height: 52px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.3); background: rgba(0, 0, 0, 0.3); color: #fff; display: grid; place-items: center; }
  .lb-close { top: 16px; right: 16px; }
  .lb-prev { left: 16px; top: 50%; translate: 0 -50%; }
  .lb-next { right: 16px; top: 50%; translate: 0 -50%; }
</style>
